// Omas wheel menu — Fly-Pie (https://github.com/Schneegans/Fly-Pie), but for Omarchy.
//
// Edit this file and save: Omas reloads it live, no restart needed.
// (Saving from the built-in editor rewrites the file, so comments are lost.)
//
//   name     label shown under the icon (required)
//   icon     emoji, text glyph, or "/absolute/path/to/image" (optional).
//            A starter icon pack ships next to the plugin files, e.g.:
//            "/home/YOU/.config/omarchy/plugins/palccod.omas/web.png"
//   command  shell command to run — a node with a command is a leaf
//   children nested nodes — a node with children opens a sub-wheel; the
//            tree can grow as deep as you like
//
//   selectionMode  "click" (hover + click) or "stroke" (Fly-Pie marking
//                  mode: press, drag through items, pause or turn to select)
{
  "selectionMode": "click",
  "items": [
    {
      "name": "Web",
      "icon": "🌐",
      "children": [
        { "name": "Firefox", "icon": "🦊", "command": "firefox" },
        { "name": "Private window", "icon": "🕵️", "command": "firefox --private-window" }
      ]
    },
    {
      "name": "System",
      "icon": "⚙️",
      "children": [
        { "name": "Lock", "icon": "🔒", "command": "omarchy system lock" },
        {
          "name": "Power",
          "icon": "⏻",
          "children": [
            { "name": "Reboot", "icon": "🔄", "command": "systemctl reboot" },
            { "name": "Shutdown", "icon": "⏹️", "command": "systemctl poweroff" }
          ]
        }
      ]
    },
    { "name": "Terminal", "icon": "💻", "command": "alacritty" },
    { "name": "Screenshot", "icon": "📸", "command": "omarchy capture screenshot" },
    { "name": "Files", "icon": "📁", "command": "xdg-open ~" },
    { "name": "VS-Code", "icon": "🫥", "command": "code" }
  ]
}
